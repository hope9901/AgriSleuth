# Single project configuration. Copy to .env only for a fresh installation.
# Never overwrite an existing .env or commit real credentials.
# Explicit process environment variables take precedence over this file.

# Browser-public setting. Only VITE_ variables enter the frontend bundle.
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL application database. Keep values consistent with the existing container.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agrisleuth
POSTGRES_USER=agrisleuth
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=10
# Optional alternative to POSTGRES_*:
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/agrisleuth

# Local LM Studio. Use the exact loaded model ID.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.5-9b
LM_STUDIO_API_KEY=lm-studio
LOCAL_MODEL_TIMEOUT_SECONDS=180
USE_IMAGE_OBSERVATIONS=true

# KMA API Hub. Server-side credentials must never use a VITE_ prefix.
KMA_AUTH_KEY=

# Zetaris client access and recorded read-only JDBC role credential.
ZETARIS_BASE_URL=http://127.0.0.1:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_SOURCE_PASSWORD=
ZETARIS_EVIDENCE_TABLE=AGRISLEUTH.disease_evidence

# Runtime budgets and optional explicit Node executable.
NODE_BINARY=
AGENT_MAX_ITERATIONS=5
AGENT_DEADLINE_SECONDS=480
