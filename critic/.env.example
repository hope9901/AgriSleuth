LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Copy the exact model ID from GET http://localhost:1234/v1/models.
# Leave blank to run intake without Critic review.
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=lm-studio

# Falls back to POSTGRES_* in ../data/.env.postgres when DATABASE_URL is unset.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/agrisleuth

# KMA API Hub key; authorize world GTS station info and SYNOP services.
KMA_AUTH_KEY=

# Zetaris UI proxy routes, used by retrieval.py. Keep credentials server-side.
ZETARIS_BASE_URL=http://127.0.0.1:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_EVIDENCE_TABLE=AGRISLEUTH.disease_evidence
# Node 23+ with --experimental-transform-types support (or compatible newer release)
NODE_BINARY=

# Requires a vision-capable loaded LM Studio model. Failures fall back to typed symptoms.
USE_IMAGE_OBSERVATIONS=true

# Autonomous action budget (including finish), bounded by host validation.
AGENT_MAX_ITERATIONS=5
AGENT_DEADLINE_SECONDS=480

# Per local model call; total agent deadline remains 480 seconds by default.
LOCAL_MODEL_TIMEOUT_SECONDS=180

# Allow brief memory-pressure delays during local inference; range 1–30.
POSTGRES_CONNECT_TIMEOUT=10
